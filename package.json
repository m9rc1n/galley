{
  "name": "galley",
  "version": "0.3.1",
  "private": true,
  "description": "Read markdown changes in GitHub pull requests and GitLab merge requests like an article.",
  "license": "MIT",
  "author": "Marcin Urbanski",
  "homepage": "https://github.com/m9rc1n/galley#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m9rc1n/galley.git"
  },
  "bugs": {
    "url": "https://github.com/m9rc1n/galley/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:zip": "node scripts/dev.mjs --zip",
    "zip": "node scripts/build.mjs --zip",
    "demo": "node scripts/build.mjs && node scripts/serve.mjs",
    "icons": "node scripts/icons.mjs",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "store-assets": "node scripts/build.mjs && node scripts/store-assets.mjs",
    "release": "npm test && npm run typecheck && node scripts/build.mjs --zip && node scripts/privacy-page.mjs",
    "privacy-page": "node scripts/privacy-page.mjs",
    "submit-helper": "node scripts/submit-helper.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "linkedom": "^0.18.13",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
